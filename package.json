{
    "name": "@prezly/content-renderer-react-js",
    "version": "0.44.4",
    "description": "Render Prezly Content Format documents with React.js",
    "license": "MIT",
    "packageManager": "pnpm@11.25.0",
    "main": "build/cjs/index.cjs",
    "module": "build/esm/index.mjs",
    "types": "build/types/index.d.ts",
    "style": "build/styles/styles.css",
    "exports": {
        ".": {
            "types": "./build/types/index.d.ts",
            "import": "./build/esm/index.mjs",
            "default": "./build/cjs/index.cjs"
        },
        "./styles.css": "./build/styles/styles.css"
    },
    "files": [
        "build"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/prezly/content-renderer-react-js.git"
    },
    "bugs": {
        "url": "https://github.com/prezly/content-renderer-react-js/issues"
    },
    "homepage": "https://github.com/prezly/content-renderer-react-js#readme",
    "scripts": {
        "start": "pnpm build:dev && concurrently --names=' watch ,sandbox' 'pnpm watch' 'pnpm sandbox'",
        "sandbox": "NODE_ENV=development webpack serve --hot",
        "build": "NODE_ENV=production pnpm build:all",
        "build:dev": "NODE_ENV=development pnpm build:all",
        "build:all": "pnpm build:types && pnpm build:cjs && pnpm build:esm && pnpm build:sass",
        "build:types": "tsc --project ./tsconfig.build.json",
        "build:cjs": "gulp build:cjs",
        "build:esm": "gulp build:esm",
        "build:sass": "gulp build:sass",
        "watch": "NODE_ENV=development concurrently --kill-others --names 'd.ts, cjs, esm,sass' 'pnpm watch:types' 'pnpm watch:cjs' 'pnpm watch:esm' 'pnpm watch:sass'",
        "watch:types": "tsc-fancy --preserveConsoleOutput --project ./tsconfig.build.json --watch --pretty",
        "watch:cjs": "gulp watch:cjs",
        "watch:esm": "gulp watch:esm",
        "watch:sass": "gulp watch:sass",
        "clean": "pnpm clean:build && pnpm clean:node_modules",
        "clean:build": "rimraf build/",
        "clean:node_modules": "rimraf node_modules/",
        "check": "pnpm prettier && pnpm test",
        "lint": "eslint .",
        "lint:fix": "pnpm lint --fix",
        "lint-styles": "pnpm exec stylelint **.scss",
        "lint-styles:fix": "pnpm lint-styles --fix",
        "prettier": "prettier --check './**/*.(js|ts|tsx|scss)'",
        "prettier:fix": "pnpm prettier --write --no-list-different",
        "release": "np --test-script='release:check'",
        "release:preview": "pnpm release --any-branch --tag preview --no-release-draft",
        "release:check": "pnpm clean && pnpm install --frozen-lockfile && pnpm build && pnpm check",
        "test:with-all-react-versions": "pnpm test:with-react-18",
        "test:with-react-18": "REACT_VERSION=18 pnpm test:with-react-version",
        "test:with-react-version": "pnpm react:uninstall && pnpm react:install-version && pnpm clean:build && pnpm build && pnpm test",
        "test": "pnpm test:unit && pnpm test:build",
        "test:build": "pnpm test:types && pnpm test:cjs && pnpm test:esm && pnpm test:styles",
        "test:types": "ls build/types/index.d.ts || (echo 'Missing build/types/index.d.ts file.' && false)",
        "test:styles": "ls build/styles/styles.css || (echo 'Missing build/styles/styles.css file.' && false)",
        "test:cjs": "node build/cjs/index.cjs",
        "test:esm": "node build/esm/index.mjs",
        "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --no-cache",
        "test:watch": "pnpm test:unit --watch",
        "react:install-version": "pnpm add --save-dev react@$REACT_VERSION react-dom@$REACT_VERSION react-test-renderer@$REACT_VERSION @types/react@$REACT_VERSION @types/react-dom@$REACT_VERSION @types/react-test-renderer@$REACT_VERSION",
        "react:uninstall": "pnpm remove react react-dom react-test-renderer @types/react @types/react-dom @types/react-test-renderer",
        "loki": "loki",
        "loki:update": "loki update",
        "loki:static-build": "loki  --reactUri file:./storybook-static",
        "storybook": "start-storybook -p 6006",
        "build-storybook": "build-storybook"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=22"
        },
        "packageManager": {
            "name": "pnpm",
            "version": "11.25.0"
        }
    },
    "peerDependencies": {
        "react": "18",
        "react-dom": "18"
    },
    "dependencies": {
        "@prezly/linear-partition": "^1.0.3",
        "@prezly/sdk": "^26.8.0",
        "@prezly/story-content-format": "^0.71.0",
        "@prezly/uploadcare": "^2.6.0",
        "@react-hookz/web": "^26.1.0",
        "classnames": "^2.5.1",
        "js-cookie": "^3.0.8",
        "player.js": "^0.1.0",
        "react-modal": "^3.16.3",
        "resize-observer-polyfill": "^1.5.1",
        "shave": "^5.1.0",
        "social-links": "^1.15.1"
    },
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.7",
        "@babel/plugin-transform-modules-commonjs": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@babel/preset-typescript": "^7.29.7",
        "@dr.pogodin/babel-preset-svgr": "1.9.3",
        "@loki/create-async-callback": "^0.30.2",
        "@loki/is-loki-running": "^0.30.0",
        "@pmmmwh/react-refresh-webpack-plugin": "^0.5.7",
        "@prezly/eslint-config": "^6.0.0",
        "@storybook/addon-actions": "^6.5.9",
        "@storybook/addon-essentials": "^6.5.9",
        "@storybook/addon-interactions": "^6.5.9",
        "@storybook/addon-links": "^6.5.9",
        "@storybook/builder-webpack5": "^6.5.9",
        "@storybook/manager-webpack5": "^6.5.9",
        "@storybook/react": "^6.5.9",
        "@storybook/testing-library": "^0.0.13",
        "@types/glob": "^7.1.3",
        "@types/jest": "^30.0.0",
        "@types/node": "22.20.1",
        "@types/react": "^18.0.15",
        "@types/react-dom": "^18.0.6",
        "@types/react-modal": "^3.10.6",
        "@types/react-test-renderer": "^18.0.0",
        "@types/vinyl": "^2.0.6",
        "autoprefixer": "^10.4.7",
        "babel-loader": "^8.2.5",
        "babel-plugin-add-import-extension": "^1.6.0",
        "babel-plugin-transform-remove-imports": "^1.7.0",
        "branch-pipe": "^1.0.1",
        "concurrently": "^6.5.1",
        "css-loader": "^6.7.1",
        "eslint": "^9.39.5",
        "eslint-plugin-prettier": "^5.5.6",
        "gulp": "^4.0.2",
        "gulp-babel": "^8.0.0",
        "gulp-concat": "^2.6.1",
        "gulp-filter": "^7.0.0",
        "gulp-map": "^0.0.2",
        "gulp-postcss": "^9.0.1",
        "gulp-rename": "^2.0.0",
        "gulp-sass": "^5.0.0",
        "html-webpack-plugin": "^5.5.0",
        "jest": "^30.5.1",
        "jest-environment-jsdom": "^30.5.1",
        "loki": "^0.30.3",
        "np": "^7.6.2",
        "postcss": "^8.4.14",
        "prettier": "^3.2.5",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-refresh": "^0.14.0",
        "react-test-renderer": "^18.2.0",
        "rimraf": "^3.0.2",
        "sass": "^1.53.0",
        "sass-loader": "^13.0.2",
        "style-loader": "^3.3.1",
        "stylelint": "^16.26.1",
        "ts-jest": "^29.4.12",
        "tsc-fancy": "^1.1.2",
        "typescript": "^6.0.3",
        "url-polyfill": "^1.1.12",
        "webpack": "^5.73.0",
        "webpack-cli": "^4.10.0",
        "webpack-dev-server": "^4.9.3"
    }
}
