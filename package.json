{
    "name": "@prezly/content-renderer-react-js",
    "version": "0.44.4",
    "description": "Render Prezly Content Format documents with React.js",
    "license": "MIT",
    "packageManager": "pnpm@11.25.0",
    "main": "build/cjs/index.cjs",
    "module": "build/esm/index.mjs",
    "types": "build/types/index.d.ts",
    "style": "build/styles/styles.css",
    "exports": {
        ".": {
            "types": "./build/types/index.d.ts",
            "import": "./build/esm/index.mjs",
            "default": "./build/cjs/index.cjs"
        },
        "./styles.css": "./build/styles/styles.css"
    },
    "files": [
        "build"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/prezly/content-renderer-react-js.git"
    },
    "bugs": {
        "url": "https://github.com/prezly/content-renderer-react-js/issues"
    },
    "homepage": "https://github.com/prezly/content-renderer-react-js#readme",
    "scripts": {
        "start": "pnpm build:dev && concurrently --names=' watch ,sandbox' 'pnpm watch' 'pnpm sandbox'",
        "sandbox": "NODE_ENV=development webpack serve --hot",
        "build": "NODE_ENV=production pnpm build:all",
        "build:dev": "NODE_ENV=development pnpm build:all",
        "build:all": "pnpm build:types && pnpm build:cjs && pnpm build:esm && pnpm build:sass",
        "build:types": "tsc --project ./tsconfig.build.json",
        "build:cjs": "gulp build:cjs",
        "build:esm": "gulp build:esm",
        "build:sass": "gulp build:sass",
        "build:sandbox": "NODE_ENV=production webpack build",
        "watch": "NODE_ENV=development concurrently --kill-others --names 'd.ts, cjs, esm,sass' 'pnpm watch:types' 'pnpm watch:cjs' 'pnpm watch:esm' 'pnpm watch:sass'",
        "watch:types": "tsc-fancy --preserveConsoleOutput --project ./tsconfig.build.json --watch --pretty",
        "watch:cjs": "gulp watch:cjs",
        "watch:esm": "gulp watch:esm",
        "watch:sass": "gulp watch:sass",
        "clean": "pnpm clean:build && pnpm clean:node_modules",
        "clean:build": "rimraf build/",
        "clean:node_modules": "rimraf node_modules/",
        "check": "pnpm lint && pnpm lint-styles && pnpm test",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "lint-styles": "pnpm exec stylelint **.scss",
        "lint-styles:fix": "pnpm lint-styles --fix",
        "format": "biome format .",
        "format:fix": "biome format --write .",
        "release": "np --test-script='release:check'",
        "release:preview": "pnpm release --any-branch --tag preview --no-release-draft",
        "release:check": "pnpm clean && pnpm install --frozen-lockfile && pnpm build && pnpm check",
        "test:with-all-react-versions": "pnpm test:with-react-18 && pnpm test:with-react-19",
        "test:with-react-18": "REACT_VERSION=18 pnpm test:with-react-version",
        "test:with-react-19": "REACT_VERSION=19 pnpm test:with-react-version",
        "test:with-react-version": "pnpm react:uninstall && pnpm react:install-version && pnpm clean:build && pnpm build && pnpm test",
        "test": "pnpm test:unit && pnpm test:build",
        "test:build": "pnpm test:types && pnpm test:cjs && pnpm test:esm && pnpm test:styles",
        "test:types": "ls build/types/index.d.ts || (echo 'Missing build/types/index.d.ts file.' && false)",
        "test:styles": "ls build/styles/styles.css || (echo 'Missing build/styles/styles.css file.' && false)",
        "test:cjs": "node build/cjs/index.cjs",
        "test:esm": "node build/esm/index.mjs",
        "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --no-cache",
        "test:watch": "pnpm test:unit --watch",
        "react:install-version": "pnpm add --save-dev react@$REACT_VERSION react-dom@$REACT_VERSION @types/react@$REACT_VERSION @types/react-dom@$REACT_VERSION",
        "react:uninstall": "pnpm remove react react-dom @types/react @types/react-dom",
        "test:visual": "pnpm build-storybook && pnpm test:visual:docker",
        "test:visual:update": "pnpm test:visual --update-snapshots",
        "test:visual:docker": "docker run --rm --platform linux/amd64 --volume \"$PWD\":/work --volume /work/node_modules --volume /work/example/node_modules --workdir /work mcr.microsoft.com/playwright:v1.62.1-noble bash -lc 'corepack enable && pnpm install --frozen-lockfile && pnpm exec playwright test \"$@\"' --",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=22.13"
        },
        "packageManager": {
            "name": "pnpm",
            "version": "11.25.0"
        }
    },
    "peerDependencies": {
        "react": "^18 || ^19",
        "react-dom": "^18 || ^19"
    },
    "dependencies": {
        "@prezly/linear-partition": "^1.0.3",
        "@prezly/sdk": "^26.8.0",
        "@prezly/story-content-format": "^0.71.0",
        "@prezly/uploadcare": "^2.6.0",
        "@react-hookz/web": "^26.1.0",
        "classnames": "^2.5.1",
        "js-cookie": "^3.0.8",
        "player.js": "^0.1.0",
        "react-modal": "^3.16.3",
        "resize-observer-polyfill": "^1.5.1",
        "shave": "^5.1.0",
        "social-links": "^1.15.1"
    },
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.7",
        "@babel/plugin-transform-modules-commonjs": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "@babel/preset-typescript": "^7.29.7",
        "@biomejs/biome": "^2.5.11",
        "@dr.pogodin/babel-preset-svgr": "1.9.3",
        "@playwright/test": "^1.62.1",
        "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
        "@storybook/react": "^10.5.10",
        "@storybook/react-webpack5": "^10.5.10",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.3",
        "@types/jest": "^30.0.0",
        "@types/node": "22.20.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@types/react-modal": "^3.10.6",
        "@types/webpack-env": "^1.18.8",
        "autoprefixer": "^10.5.4",
        "babel-loader": "^10.1.1",
        "babel-plugin-add-import-extension": "^1.6.0",
        "babel-plugin-transform-remove-imports": "^1.7.0",
        "branch-pipe": "^1.0.1",
        "concurrently": "^10.0.5",
        "css-loader": "^7.1.5",
        "gulp": "^5.0.1",
        "gulp-babel": "^8.1.0",
        "gulp-concat": "^2.6.1",
        "gulp-filter": "^10.0.0",
        "gulp-map": "^0.0.2",
        "gulp-postcss": "^10.0.0",
        "gulp-rename": "^2.1.0",
        "gulp-sass": "^6.0.1",
        "html-webpack-plugin": "^5.6.8",
        "http-server": "^14.1.1",
        "jest": "^30.5.1",
        "jest-environment-jsdom": "^30.5.1",
        "np": "^7.6.2",
        "postcss": "^8.5.26",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-refresh": "^0.18.0",
        "rimraf": "^6.1.3",
        "sass": "^1.103.1",
        "sass-loader": "^17.0.1",
        "storybook": "^10.5.10",
        "style-loader": "^4.0.0",
        "stylelint": "^17.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "ts-jest": "^29.4.12",
        "tsc-fancy": "^1.1.2",
        "typescript": "^6.0.3",
        "url-polyfill": "^1.1.12",
        "webpack": "^5.110.3",
        "webpack-cli": "^7.2.3",
        "webpack-dev-server": "^6.0.0"
    }
}
