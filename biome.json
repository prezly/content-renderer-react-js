{
    "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": ["**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs", "**/*.ts", "**/*.tsx"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "jsxQuoteStyle": "double",
            "arrowParentheses": "always",
            "trailingCommas": "all"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "a11y": {
                "noStaticElementInteractions": "warn",
                "useAriaPropsSupportedByRole": "warn",
                "useKeyWithClickEvents": "warn",
                "useValidAnchor": "warn"
            },
            "performance": {
                "noAccumulatingSpread": "warn"
            },
            "security": {
                "noDangerouslySetInnerHtml": "off"
            },
            "suspicious": {
                "noArrayIndexKey": "warn",
                "noExplicitAny": "off",
                "useIterableCallbackReturn": "warn"
            }
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["example/next-env.d.ts"],
            "javascript": {
                "formatter": {
                    "quoteStyle": "double"
                }
            }
        },
        {
            "includes": ["src/@types/**"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noRedeclare": "off"
                    }
                }
            }
        }
    ]
}
